# PostgreSQL 14+ with PostGIS 3. The app role does not need superuser once extensions exist.
DATABASE_URL=postgres://worldstate:worldstate@localhost:5432/worldstate
# Used only by `npm test` (integration tests truncate tables in this database).
TEST_DATABASE_URL=postgres://worldstate:worldstate@localhost:5432/worldstate_test
# Public origin of the app. Mutating requests whose Origin header differs are rejected.
APP_ORIGIN=http://localhost:3000
PORT=3000
# Max pooled DB connections per process (web and worker each have their own pool).
DB_POOL_MAX=10
# Optional: set to "1" behind TLS so session cookies get the Secure flag (automatic when NODE_ENV=production).
# COOKIE_SECURE=1
# Optional: map style URL (MapLibre style JSON). Defaults to OpenFreeMap "liberty".
# Set to "local" to use the built-in offline fallback style (no external tiles).
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
# Optional: raster-dem terrain tiles (terrarium encoding) used for hillshading. Set to "off" to disable.
NEXT_PUBLIC_TERRAIN_TILES=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
# Optional: error monitoring webhook; errors are POSTed as JSON when set.
# ERROR_WEBHOOK_URL=
